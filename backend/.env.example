HOST=0.0.0.0
PORT=4000
NODE_ENV=development

# ─── Storage & Queue ("auto" uses Supabase/Redis when set, or local fallback) ─
STORAGE_MODE=auto
QUEUE_MODE=auto
MAX_UPLOAD_MB=50

# ─── Supabase (Optional in local dev; required for cloud Postgres) ────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
JWT_SECRET=change-this-access-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ─── Redis (Optional; omit to run background processing in-process) ───────────
REDIS_URL=

# ─── Card-Free Speech-to-Text (MP3/MP4 Transcription — NO OpenAI Card Needed) ─
# Options: "auto" | "local-whisper" | "groq" | "gemini"
TRANSCRIPTION_PROVIDER=auto

# Option A: 100% Free Local Whisper (`pip install -r requirements-whisper.txt`)
PYTHON_BIN=python3
WHISPER_MODEL_SIZE=base

# Option B: Free Groq Cloud Key (https://console.groq.com — no credit card)
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile

# Option C: Free Google AI Studio Key (https://aistudio.google.com — no card)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── AI Summarization Provider ("auto" | "groq" | "gemini" | "ollama" | "anthropic" | "heuristic")
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ─── Safe Metadata & Optional Media Resolver ──────────────────────────────────
# Official Meta Graph API oEmbed token (optional — client apps extract preview on-device first)
FACEBOOK_APP_ACCESS_TOKEN=

# Optional self-hosted Cobalt-compatible audio resolver endpoint
EXTERNAL_MEDIA_RESOLVER_URL=
EXTERNAL_MEDIA_RESOLVER_KEY=
