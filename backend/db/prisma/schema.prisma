generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  reels      Reel[]
  categories Category[]
}

model Category {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reels     Reel[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

enum ReelStatus {
  PENDING
  EXTRACTING
  TRANSCRIBING
  SUMMARIZING
  DONE
  FAILED
}

model Reel {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceUrl           String
  title               String?
  authorHandle        String?
  caption             String?
  thumbnailUrl        String?
  transcript          String?
  summary             String?
  keyPoints           String[] @default([])
  notes               String?
  audioUrl            String?
  audioDurationSec    Float?
  transcriptionSource String?

  status       ReelStatus @default(PENDING)
  errorMessage String?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  processedAt DateTime?

  @@index([userId, status])
  @@index([userId, categoryId])
}
